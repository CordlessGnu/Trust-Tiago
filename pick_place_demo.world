<?xml version="1.0" ?>
<sdf version="1.4">
  <world name="default">
    <physics type="ode">
      <gravity>0 0 -9.81</gravity>
      <ode>
        <solver>
          <type>quick</type>
          <iters>20</iters>
          <sor>1.0</sor>
        </solver>
        <constraints>
          <cfm>0.0</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>100.0</contact_max_correcting_vel>
          <contact_surface_layer>0.0</contact_surface_layer>
        </constraints>
      </ode>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>
    
    <!-- Static Scene Camera (top down) -->
    <model name="overhead_scene_camera">
      <static>true</static>
      <pose>1.0 0.0 3.0 0 1.5708 0</pose>
      
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 0.1 0.1</size></box>
          </geometry>
        </visual>
        
        <sensor type="camera" name="overhead_camera_sensor">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
          </camera>
          <plugin name="overhead_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/overhead_camera</namespace>
            </ros>
            <frame_name>overhead_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- Static Scene Camera (side view) -->
    <model name="side_scene_camera">
      <static>true</static>
      <pose>0.75 2.0 0.8 0 0 -1.6</pose>
      
      <link name="link">
        <visual name="visual">
          <geometry>
            <box><size>0.1 0.1 0.1</size></box>
          </geometry>
        </visual>
        
        <sensor type="camera" name="scene_camera_sensor">
          <update_rate>30</update_rate>
          <camera>
            <horizontal_fov>1.047</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
          </camera>
          <plugin name="side_camera_controller" filename="libgazebo_ros_camera.so">
            <ros>
              <namespace>/side_camera</namespace>
            </ros>
            <frame_name>side_camera_optical_frame</frame_name>
          </plugin>
        </sensor>
      </link>
    </model>

    <!-- A global light source -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- A ground plane -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <include>
      <uri>model://macrolink_table</uri>
      <pose>1.0 0.0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://coke_can_slim</uri>
      <pose>0.8 0.0 0.815 0 0 -1.57</pose>
      <static>0</static>
    </include>
  </world>
</sdf>
